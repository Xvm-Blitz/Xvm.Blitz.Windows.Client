<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Xvm.Blitz.Windows.Client.UI.ViewModels"
        xmlns:models="using:Xvm.Blitz.Windows.Client.UI.ViewModels.Models"
        xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="550"
        x:Class="Xvm.Blitz.Windows.Client.UI.Windows.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/xvm.ico"
        Title="XVM Blitz"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.settingsCard">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="TextBlock.settingsCardTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{DynamicResource SubHeaderFontSize}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="Border.settingsPathCard">
            <Setter Property="Padding" Value="12" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.settingsPathCard > Grid">
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Border.settingsPathCard TextBlock.settingsCardTitle">
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>
        <Style Selector="Button.overlayToggleOn">
            <Setter Property="Background" Value="#1565C0" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#64B5F6" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.overlayToggleOn:pointerover">
            <Setter Property="Background" Value="#1976D2" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.overlayToggleOn:pressed">
            <Setter Property="Background" Value="#0D47A1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.overlayToggleOff">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderBrush" Value="#555555" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.overlayToggleOff:pointerover">
            <Setter Property="Background" Value="#353535" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <StackPanel Grid.Row="0" Spacing="10" Margin="0,0,0,15">
            <TextBlock Name="TitleTextBlock" Text="XVM Blitz Windows"
                       FontWeight="Bold" FontSize="{DynamicResource MainTitleFontSize}"
                       HorizontalAlignment="Center" />
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                <Button Grid.Column="0"
                        Content="Обучение"
                        Command="{Binding OpenTutorialCommand}"
                        FontSize="{DynamicResource SectionHeaderFontSize}"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource ButtonOrange}"
                        Foreground="{DynamicResource ButtonOrangeText}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonOrangeHover}" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="{DynamicResource ButtonOrangePressed}" />
                        </Style>
                    </Button.Styles>
                </Button>
                <Button Grid.Column="2"
                        Content="{Binding AuthDisplayText}"
                        Command="{Binding OpenAuthWindowCommand}"
                        FontSize="{DynamicResource SectionHeaderFontSize}"
                        Padding="10,5"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{DynamicResource ButtonGreen}"
                        Foreground="{DynamicResource ButtonGreenText}">
                    <Button.Styles>
                        <Style Selector="Button:pointerover">
                            <Setter Property="Background" Value="{DynamicResource ButtonGreenHover}" />
                        </Style>
                        <Style Selector="Button:pressed">
                            <Setter Property="Background" Value="{DynamicResource ButtonGreenPressed}" />
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="15">

                <Expander Header="Общие настройки" IsExpanded="True" HorizontalAlignment="Stretch"
                          FontSize="{DynamicResource SectionHeaderFontSize}">
                    <StackPanel Spacing="12" Margin="10">
                        <UniformGrid Columns="3" HorizontalAlignment="Stretch">
                            <Border Classes="settingsCard" Margin="0,0,5,0" VerticalAlignment="Stretch">
                                <Grid RowDefinitions="*,Auto">
                                    <StackPanel Grid.Row="0" VerticalAlignment="Top" Spacing="10">
                                        <TextBlock Text="Обновление" Classes="settingsCardTitle" />
                                        <TextBlock Text="{Binding CurrentVersionText}"
                                                   FontSize="{DynamicResource NormalFontSize}"
                                                   TextWrapping="Wrap" />
                                        <Border Background="#33FF9800"
                                                BorderBrush="Orange"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                Padding="12"
                                                IsVisible="{Binding IsUpdateAvailable}">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="Доступна новая версия"
                                                           FontWeight="Bold"
                                                           FontSize="{DynamicResource SubHeaderFontSize}"
                                                           Foreground="Orange"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding LatestVersionText}"
                                                           FontSize="{DynamicResource NormalFontSize}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="Установлена актуальная версия"
                                                   FontSize="{DynamicResource NormalFontSize}"
                                                   IsVisible="{Binding IsUpToDate}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Spacing="6" IsVisible="{Binding IsUpdateProgressVisible}">
                                            <TextBlock Text="{Binding UpdateStatusMessage}"
                                                       FontSize="{DynamicResource NormalFontSize}"
                                                       TextWrapping="Wrap" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding UpdateDownloadProgressText}"
                                                           FontSize="{DynamicResource NormalFontSize}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0" />
                                                <ProgressBar Minimum="0"
                                                             Maximum="100"
                                                             Height="8"
                                                             VerticalAlignment="Center"
                                                             Value="{Binding UpdateDownloadProgress}" />
                                            </DockPanel>
                                        </StackPanel>
                                        <TextBlock Text="{Binding UpdateStatusMessage}"
                                                   FontSize="{DynamicResource NormalFontSize}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasUpdateStatusMessage}" />
                                    </StackPanel>
                                    <WrapPanel Grid.Row="1"
                                               Margin="0,10,0,0"
                                               Orientation="Horizontal">
                                        <Button Content="Проверить"
                                                Command="{Binding CheckForUpdatesCommand}"
                                                Background="{DynamicResource ButtonGreen}"
                                                Foreground="{DynamicResource ButtonGreenText}"
                                                Padding="15,8"
                                                Margin="0,0,10,0"
                                                FontSize="{DynamicResource NormalFontSize}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenHover}" />
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenPressed}" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                        <Button Content="{Binding UpdateDownloadButtonText}"
                                                Command="{Binding DownloadUpdateCommand}"
                                                IsVisible="{Binding IsUpdateAvailable}"
                                                Background="{DynamicResource ButtonGreen}"
                                                Foreground="{DynamicResource ButtonGreenText}"
                                                Padding="15,8"
                                                FontSize="{DynamicResource NormalFontSize}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenHover}" />
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenPressed}" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Classes="settingsCard" Margin="5,0,5,0" VerticalAlignment="Stretch">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Приложение" Classes="settingsCardTitle" />
                                    <CheckBox Content="Сворачивать в трей при закрытии основного окна"
                                              IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}"
                                              FontSize="{DynamicResource NormalFontSize}" />
                                    <CheckBox Content="Не беспокоить (голосовой чат)"
                                              IsChecked="{Binding VoiceDoNotDisturb, Mode=TwoWay}"
                                              FontSize="{DynamicResource NormalFontSize}" />
                                </StackPanel>
                            </Border>

                            <Border Classes="settingsCard" Margin="5,0,0,0" VerticalAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="Панели на экране" Classes="settingsCardTitle" />
                                    <TextBlock Text="Включите режим настройки, перетащите панели и измените размер уголком. Положение и размер сохраняются автоматически."
                                               FontSize="{DynamicResource NormalFontSize}"
                                               TextWrapping="Wrap"
                                               Opacity="0.75" />
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Режим настройки панелей"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource NormalFontSize}"
                                                   TextWrapping="Wrap" />
                                        <ToggleSwitch Grid.Column="1"
                                                      IsChecked="{Binding IsDisplayConfigurationMode}"
                                                      OnContent=""
                                                      OffContent="" />
                                    </Grid>
                                    <Button Content="Сбросить координаты"
                                            Command="{Binding ResetOverlayPositionsCommand}"
                                            HorizontalAlignment="Stretch"
                                            Padding="12,8"
                                            FontSize="{DynamicResource NormalFontSize}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid ColumnDefinitions="*,*"
                              Grid.IsSharedSizeScope="True"
                              HorizontalAlignment="Stretch">
                            <Border Grid.Column="0" Classes="settingsCard settingsPathCard" Margin="0,0,5,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,*">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="SettingsTitle" />
                                        <RowDefinition Height="Auto" SharedSizeGroup="SettingsPath" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Реплеи" Classes="settingsCardTitle" />
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" MinWidth="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsPathLabel" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsPathButton" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Путь:" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   FontSize="{DynamicResource NormalFontSize}" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding ReplaysPath, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,10,0"
                                                 FontSize="{DynamicResource NormalFontSize}"
                                                 ToolTip.Tip="{Binding ReplaysPath}" />
                                        <Button Grid.Column="2" Content="Обзор…" Command="{Binding SelectReplaysPathCommand}"
                                                Padding="10,6"
                                                FontSize="{DynamicResource NormalFontSize}" />
                                    </Grid>
                                    <Button Grid.Row="2"
                                            Name="OpenReplaysButton"
                                            Content="Открыть папку реплеев"
                                            Command="{Binding OpenReplaysPathCommand}"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            Padding="12,8"
                                            Margin="0,10,0,0"
                                            FontSize="{DynamicResource NormalFontSize}" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="1" Classes="settingsCard settingsPathCard" Margin="5,0,0,0">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" SharedSizeGroup="SettingsTitle" />
                                        <RowDefinition Height="Auto" SharedSizeGroup="SettingsPath" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Экран загрузки боя" Classes="settingsCardTitle" />
                                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" MinWidth="200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsPathLabel" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingsPathButton" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Путь:" VerticalAlignment="Center" Margin="0,0,10,0"
                                                   FontSize="{DynamicResource NormalFontSize}"
                                                   ToolTip.Tip="Папка с игрой Tanks Blitz" />
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding GamePath, UpdateSourceTrigger=LostFocus}"
                                                 Margin="0,0,10,0"
                                                 FontSize="{DynamicResource NormalFontSize}"
                                                 ToolTip.Tip="{Binding GamePath}" />
                                        <Button Grid.Column="2" Content="..." Command="{Binding SelectGamePathCommand}"
                                                Padding="10,6"
                                                FontSize="{DynamicResource NormalFontSize}" />
                                    </Grid>
                                    <WrapPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="Заменить"
                                                Command="{Binding ReplaceLoadingScreenCommand}"
                                                Background="{DynamicResource ButtonGreen}"
                                                Foreground="{DynamicResource ButtonGreenText}"
                                                Padding="12,8"
                                                Margin="0,0,10,8"
                                                FontSize="{DynamicResource NormalFontSize}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenHover}" />
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenPressed}" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                        <Button Content="Вернуть исходные"
                                                Command="{Binding RestoreLoadingScreenFilesCommand}"
                                                Background="{DynamicResource ButtonGreen}"
                                                Foreground="{DynamicResource ButtonGreenText}"
                                                Padding="12,8"
                                                Margin="0,0,10,8"
                                                FontSize="{DynamicResource NormalFontSize}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenHover}" />
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonGreenPressed}" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                        <Button Content="По умолчанию"
                                                Command="{Binding RestoreLoadingScreenDefaultsCommand}"
                                                Background="{DynamicResource ButtonOrange}"
                                                Foreground="{DynamicResource ButtonOrangeText}"
                                                Padding="12,8"
                                                Margin="0,0,10,8"
                                                FontSize="{DynamicResource NormalFontSize}">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonOrangeHover}" />
                                                </Style>
                                                <Style Selector="Button:pressed">
                                                    <Setter Property="Background" Value="{DynamicResource ButtonOrangePressed}" />
                                                </Style>
                                            </Button.Styles>
                                        </Button>
                                        <CheckBox Content="Заменён"
                                                  IsChecked="{Binding IsLoadingScreenReplaced}"
                                                  IsEnabled="False"
                                                  FontSize="{DynamicResource NormalFontSize}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <Border Grid.Row="3"
                                            Background="#33FF9800"
                                            BorderBrush="Orange"
                                            BorderThickness="2"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,10,0,0"
                                            IsVisible="{Binding IsLoadingScreenWarningVisible}">
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="Для распознавания необходимо заменить экран загрузки боя"
                                                       FontWeight="Bold"
                                                       FontSize="{DynamicResource SubHeaderFontSize}"
                                                       Foreground="Orange"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="Пока экран загрузки не заменён, статистика боя распознаваться не будет."
                                                       FontSize="{DynamicResource NormalFontSize}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Grid.Row="4"
                                               Text="{Binding LoadingScreenMessage}"
                                               IsVisible="{Binding HasLoadingScreenMessage}"
                                               Foreground="{Binding LoadingScreenIsError, Converter={StaticResource ErrorToColorConverter}}"
                                               FontSize="{DynamicResource NormalFontSize}"
                                               TextWrapping="Wrap"
                                               Margin="0,10,0,0" />
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Expander>

                <Expander Header="Сессии боёв" IsExpanded="True" HorizontalAlignment="Stretch"
                          FontSize="{DynamicResource SectionHeaderFontSize}">
                    <StackPanel Spacing="12" Margin="10">
                        <Border Background="#33FF9800"
                                BorderBrush="Orange"
                                BorderThickness="2"
                                CornerRadius="8"
                                Padding="12">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Сессия действует не дольше 24 часов"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource SubHeaderFontSize}"
                                           Foreground="Orange"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="По истечении 24 часов незавершённая сессия будет автоматически закрыта, если в ней нет начавшихся боёв."
                                           FontSize="{DynamicResource NormalFontSize}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsCard">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Действия" Classes="settingsCardTitle" />
                                <TextBlock Text="Для работы с сессиями войдите через Lesta OpenID. Активная сессия привязана к вашему аккаунту."
                                           FontSize="{DynamicResource SmallNoteFontSize}"
                                           TextWrapping="Wrap"
                                           Opacity="0.85" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Начать сессию"
                                            Command="{Binding StartSessionCommand}"
                                            IsEnabled="{Binding !IsSessionBusy}"
                                            Background="{DynamicResource ButtonGreen}"
                                            Foreground="{DynamicResource ButtonGreenText}"
                                            Padding="15,8"
                                            Margin="0,0,10,8"
                                            FontSize="{DynamicResource NormalFontSize}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ButtonGreenHover}" />
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="Background" Value="{DynamicResource ButtonGreenPressed}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    <Button Content="Загрузить историю"
                                            Command="{Binding RestoreSessionsCommand}"
                                            IsEnabled="{Binding !IsSessionBusy}"
                                            Background="{DynamicResource ButtonOrange}"
                                            Foreground="{DynamicResource ButtonOrangeText}"
                                            Padding="15,8"
                                            Margin="0,0,10,8"
                                            FontSize="{DynamicResource NormalFontSize}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ButtonOrangeHover}" />
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="Background" Value="{DynamicResource ButtonOrangePressed}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                    <Button Content="Завершить сессию"
                                            Command="{Binding EndSessionCommand}"
                                            IsEnabled="{Binding CanEndSelectedSession}"
                                            Background="{DynamicResource ButtonRed}"
                                            Foreground="{DynamicResource ButtonRedText}"
                                            Padding="15,8"
                                            Margin="0,0,10,8"
                                            FontSize="{DynamicResource NormalFontSize}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="{DynamicResource ButtonRedHover}" />
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="Background" Value="{DynamicResource ButtonRedPressed}" />
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </WrapPanel>
                                <TextBlock Text="{Binding SessionStatusMessage}"
                                           FontSize="{DynamicResource NormalFontSize}"
                                           TextWrapping="Wrap"
                                           Foreground="#E57373"
                                           IsVisible="{Binding HasSessionStatusError}" />
                                <TextBlock Text="{Binding SessionStatusMessage}"
                                           FontSize="{DynamicResource NormalFontSize}"
                                           TextWrapping="Wrap"
                                           Foreground="#81C784"
                                           IsVisible="{Binding HasSessionStatusSuccess}" />
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsCard">
                            <StackPanel Spacing="8">
                                <TextBlock Text="История сессий" Classes="settingsCardTitle" />
                                <ComboBox ItemsSource="{Binding AvailableSessions}"
                                          SelectedItem="{Binding SelectedSession}"
                                          PlaceholderText="Нет сессий в истории"
                                          HorizontalAlignment="Stretch"
                                          FontSize="{DynamicResource NormalFontSize}"
                                          IsEnabled="{Binding !IsSessionBusy}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:SessionListItem">
                                            <TextBlock Text="{Binding DisplayText}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                    <Button Content="◀"
                                            Command="{Binding PreviousSessionHistoryPageCommand}"
                                            IsEnabled="{Binding HasPreviousSessionHistoryPage}"
                                            MinWidth="36"
                                            Padding="8,4"
                                            FontSize="{DynamicResource NormalFontSize}" />
                                    <TextBlock Text="{Binding SessionHistoryPageText}"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource NormalFontSize}" />
                                    <Button Content="▶"
                                            Command="{Binding NextSessionHistoryPageCommand}"
                                            IsEnabled="{Binding HasNextSessionHistoryPage}"
                                            MinWidth="36"
                                            Padding="8,4"
                                            FontSize="{DynamicResource NormalFontSize}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="settingsCard" IsVisible="{Binding HasSelectedSession}">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBlock Text="{Binding SessionBattlesHeader}"
                                               Classes="settingsCardTitle"
                                               Margin="0"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Обновить"
                                                Command="{Binding RefreshSessionBattlesCommand}"
                                                IsEnabled="{Binding !IsSessionBattlesLoading}"
                                                Padding="12,6"
                                                FontSize="{DynamicResource NormalFontSize}" />
                                        <Button Content="{Binding SessionSummaryOverlayButtonText}"
                                                Command="{Binding ToggleSessionSummaryOverlayCommand}"
                                                Classes.overlayToggleOn="{Binding IsSessionSummaryOverlayButtonActive}"
                                                Classes.overlayToggleOff="{Binding !IsSessionSummaryOverlayButtonActive}"
                                                Padding="12,6"
                                                MinWidth="170"
                                                FontSize="{DynamicResource NormalFontSize}" />
                                    </StackPanel>
                                </Grid>
                            <TextBlock Text="Загрузка боёв…"
                                       FontSize="{DynamicResource NormalFontSize}"
                                       Opacity="0.7"
                                       IsVisible="{Binding IsSessionBattlesLoading}" />
                            <TextBlock Text="В этой сессии пока нет боёв"
                                       FontSize="{DynamicResource NormalFontSize}"
                                       Opacity="0.7"
                                       IsVisible="{Binding HasNoSessionBattles}" />
                            <ScrollViewer MaxHeight="260"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding !IsSessionBattlesLoading}">
                                <dg:DataGrid ItemsSource="{Binding SessionBattles}"
                                             IsReadOnly="True"
                                             CanUserReorderColumns="False"
                                             CanUserResizeColumns="False"
                                             CanUserSortColumns="False"
                                             GridLinesVisibility="Horizontal"
                                             HeadersVisibility="Column"
                                             AutoGenerateColumns="False"
                                             FontSize="{DynamicResource NormalFontSize}"
                                             HorizontalAlignment="Left">
                                    <dg:DataGrid.Columns>
                                        <dg:DataGridTextColumn Header="Начало"
                                                               Binding="{Binding StartedAtText}"
                                                               Width="Auto" />
                                        <dg:DataGridTextColumn Header="Танк"
                                                               Binding="{Binding TankName}"
                                                               Width="Auto" />
                                        <dg:DataGridTemplateColumn Header="Результат"
                                                                   Width="Auto">
                                            <dg:DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate DataType="models:SessionBattleListItem">
                                                    <Border Background="{Binding ResultBackground}"
                                                            Padding="6,4">
                                                        <TextBlock Text="{Binding ResultText}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                </DataTemplate>
                                            </dg:DataGridTemplateColumn.CellTemplate>
                                        </dg:DataGridTemplateColumn>
                                        <dg:DataGridTextColumn Header="Фраги"
                                                               Binding="{Binding FragsText}"
                                                               Width="Auto" />
                                        <dg:DataGridTextColumn Header="Урон"
                                                               Binding="{Binding DamageText}"
                                                               Width="Auto" />
                                    </dg:DataGrid.Columns>
                                </dg:DataGrid>
                            </ScrollViewer>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Left"
                                        Margin="0,8,0,0"
                                        IsVisible="{Binding ShowSessionBattlesPagination}">
                                <Button Content="◀"
                                        Command="{Binding PreviousSessionBattlesPageCommand}"
                                        IsEnabled="{Binding HasPreviousSessionBattlesPage}"
                                        MinWidth="36"
                                        Padding="8,4"
                                        FontSize="{DynamicResource NormalFontSize}" />
                                <TextBlock Text="{Binding SessionBattlesPageText}"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource NormalFontSize}" />
                                <Button Content="▶"
                                        Command="{Binding NextSessionBattlesPageCommand}"
                                        IsEnabled="{Binding HasNextSessionBattlesPage}"
                                        MinWidth="36"
                                        Padding="8,4"
                                        FontSize="{DynamicResource NormalFontSize}" />
                            </StackPanel>
                            <TextBlock Text="{x:Static vm:MainViewModel.SessionStatisticsDisclaimerText}"
                                       FontSize="{DynamicResource NormalFontSize}"
                                       TextWrapping="Wrap"
                                       Opacity="0.75"
                                       Margin="0,8,0,0"
                                       IsVisible="{Binding ShowSessionStatisticsDisclaimer}" />
                            <Border Background="#1AFFFFFF"
                                    CornerRadius="8"
                                    Padding="12"
                                    IsVisible="{Binding HasSessionBattlesSummary}">
                                <UniformGrid Columns="2" Rows="2">
                                    <TextBlock Text="{Binding SessionBattlesTotalSummary}"
                                               FontSize="{DynamicResource NormalFontSize}"
                                               Margin="0,0,8,6" />
                                    <TextBlock Text="{Binding SessionBattlesWinRateSummary}"
                                               FontSize="{DynamicResource NormalFontSize}"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SessionBattlesAverageDamageSummary}"
                                               FontSize="{DynamicResource NormalFontSize}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SessionBattlesAverageFragsSummary}"
                                               FontSize="{DynamicResource NormalFontSize}" />
                                </UniformGrid>
                            </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Закрыть" Command="{Binding ExitCommand}"
                    MinWidth="100"
                    MinHeight="30"
                    Padding="15,5"
                    Background="{DynamicResource ButtonRed}"
                    Foreground="{DynamicResource ButtonRedText}"
                    FontSize="{DynamicResource SectionHeaderFontSize}"
                    HorizontalContentAlignment="Center">
                <Button.Styles>
                    <Style Selector="Button:pointerover">
                        <Setter Property="Background" Value="{DynamicResource ButtonRedHover}" />
                    </Style>
                    <Style Selector="Button:pressed">
                        <Setter Property="Background" Value="{DynamicResource ButtonRedPressed}" />
                    </Style>
                </Button.Styles>
            </Button>
        </StackPanel>
    </Grid>
</Window>
