<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="120"
        x:Class="Xvm.Blitz.Windows.Client.UI.Windows.StatisticsErrorOverlayWindow"
        Icon="/Assets/xvm.ico"
        Title=""
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="Transparent">

    <Border x:Name="Root"
            Background="#80000000"
            CornerRadius="5"
            Padding="24,18"
            MinWidth="320"
            MaxWidth="520">
        <StackPanel Spacing="8" MaxWidth="472">
            <TextBlock Text="Ошибка запроса статистики"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="White"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorMessage"
                       FontSize="14"
                       Foreground="White"
                       Opacity="0.9"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
