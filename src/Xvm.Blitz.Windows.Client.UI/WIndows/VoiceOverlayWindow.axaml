<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Xvm.Blitz.Windows.Client.UI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="260" d:DesignHeight="120"
        x:Class="Xvm.Blitz.Windows.Client.UI.Windows.VoiceOverlayWindow"
        x:DataType="vm:VoiceOverlayViewModel"
        Icon="/Assets/xvm.ico"
        Title=""
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        MinWidth="{Binding OverlayMinWidth}"
        WindowStartupLocation="Manual"
        SystemDecorations="None"
        Background="Transparent"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Button.micOn">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.micOn /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2E7D32" />
        </Style>
        <Style Selector="Button.micOn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#388E3C" />
        </Style>
    </Window.Styles>

    <Grid MinWidth="{Binding OverlayMinWidth}"
          ClipToBounds="False">
        <Border Background="#B3000000"
                CornerRadius="5"
                Padding="{Binding OverlayPadding}"
                MinWidth="{Binding OverlayMinWidth}"
                VerticalAlignment="Top"
                PointerPressed="Overlay_PointerPressed">
            <StackPanel Spacing="{Binding OverlaySpacing}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{Binding OverlayTitleFontSize}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding CountdownText}"
                               FontSize="{Binding OverlayTitleFontSize}"
                               Opacity="0.85"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>

                <TextBlock Text="{Binding ParticipantsText}"
                           FontSize="{Binding OverlayFontSize}"
                           TextWrapping="Wrap"
                           Opacity="0.9"
                           IsVisible="{Binding HasParticipantsText}" />

                <TextBlock Text="{Binding StatusText}"
                           FontSize="{Binding OverlayFontSize}"
                           TextWrapping="Wrap"
                           Opacity="0.85"
                           IsVisible="{Binding HasStatusText}" />

                <StackPanel Orientation="Horizontal"
                            Spacing="{Binding OverlaySpacing}"
                            IsVisible="{Binding IsIncomingVisible}">
                    <Button Content="Принять"
                            Click="Accept_Click"
                            Padding="10,4"
                            FontSize="{Binding OverlayFontSize}"
                            IsEnabled="{Binding AreCallActionsEnabled}" />
                    <Button Content="Отклонить"
                            Click="Reject_Click"
                            Padding="10,4"
                            FontSize="{Binding OverlayFontSize}"
                            IsEnabled="{Binding AreCallActionsEnabled}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Spacing="{Binding OverlaySpacing}"
                            IsVisible="{Binding IsInCallVisible}">
                    <Button Content="{Binding MuteButtonText}"
                            Classes.micOn="{Binding !IsMicMuted}"
                            Click="Mute_Click"
                            Padding="8,4"
                            FontSize="{Binding OverlayFontSize}"
                            IsEnabled="{Binding AreCallActionsEnabled}" />
                    <Button Content="Завершить"
                            Click="Hangup_Click"
                            Padding="8,4"
                            FontSize="{Binding OverlayFontSize}"
                            IsVisible="{Binding IsHangupVisible}"
                            IsEnabled="{Binding AreCallActionsEnabled}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Width="24"
                Height="24"
                Margin="0,0,1,1"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#99FFFFFF"
                CornerRadius="3"
                Cursor="BottomRightCorner"
                ZIndex="2"
                Tag="Both"
                IsHitTestVisible="True"
                IsVisible="{Binding IsDisplayConfigurationMode}"
                PointerPressed="ResizeHandle_PointerPressed" />
    </Grid>
</Window>
